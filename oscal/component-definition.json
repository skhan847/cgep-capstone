        "type": "service",
        "title": "Acme Health Patient Intake API",
        "description": "POST /intake API (API Gateway v2 -> Lambda python3.12 -> DynamoDB + S3) that accepts patient intake forms containing PHI, governed by a Terraform GRC baseline, a HIPAA Rego policy suite, and a signed-evidence GitHub Actions pipeline.",
        "purpose": "Collect patient intake submissions for a 50-person telehealth provider.",
        "props": [
          {
            "name": "primary-framework",
            "value": "HIPAA Security Rule (45 CFR 164 Subpart C)",
            "ns": "https://github.com/skhan847/cgep-capstone/ns/grc"
          }
        ],
        "responsible-roles": [
          {
            "role-id": "provider",
            "party-uuids": [
              "38ad757c-5740-5b31-9276-d16574be5de3"
